{
  "name": "quiz-desk",
  "version": "1.0.0",
  "description": "Kahoot-style pub quiz that runs on the host's laptop: rounds, music and video questions, QR join, EN/RU interface. No dependencies.",
  "license": "MIT",
  "private": true,
  "main": "server/index.js",
  "bin": { "quiz-desk": "server/index.js" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test"
  },
  "engines": { "node": ">=18" },
  "keywords": ["quiz", "kahoot", "pub-quiz", "trivia", "local", "no-dependencies"]
}
